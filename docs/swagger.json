{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Management API",
    "version": "1.0.0",
    "description": "REST API for authenticated task management with server-side filtering, sorting, and task status updates."
  },
  "servers": [
    {
      "url": "http://localhost:7073/api",
      "description": "Local Azure Functions host"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Complete application login using a validated external identity token",
        "operationId": "login",
        "responses": {
          "200": {
            "description": "Login completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Acknowledge API-side logout",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Logout completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Create or update the local application profile for the authenticated external identity",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Return the current authenticated application profile",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "User profile loaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List tasks visible to the authenticated user",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TaskStatus"
            }
          },
          {
            "name": "assignedTo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["dueDate", "status", "createdAt"],
              "default": "dueDate"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create a task",
        "operationId": "createTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "summary": "Get a task by ID",
        "operationId": "getTaskById",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "Task returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Update a task",
        "operationId": "updateTask",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Delete a task",
        "operationId": "deleteTask",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "Task deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tasks/{id}/status": {
      "patch": {
        "summary": "Update a task status",
        "operationId": "updateTaskStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tasks/stream": {
      "get": {
        "summary": "Subscribe to task status changes",
        "operationId": "streamTaskStatusUpdates",
        "responses": {
          "200": {
            "description": "Server-Sent Events stream opened",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "example": "event: task-status-updated\\ndata: {\"id\":\"f9b66f4f-92e5-4a99-9089-0e3e0fb593ad\",\"status\":\"Done\"}\\n\\n"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "A valid bearer token is required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "The task was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ResponseStatus": {
        "type": "string",
        "enum": ["ok", "error"]
      },
      "AuthUserEnvelope": {
        "type": "object",
        "required": ["data", "code", "status", "message"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AuthUserResponse"
          },
          "code": {
            "type": "string",
            "example": "AUTH_LOGIN_OK"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "message": {
            "type": "string",
            "example": "Login completed successfully."
          }
        }
      },
      "TaskEnvelope": {
        "type": "object",
        "required": ["data", "code", "status", "message"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskResponse"
          },
          "code": {
            "type": "string",
            "example": "TASK_RETRIEVED"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "message": {
            "type": "string",
            "example": "Task retrieved successfully."
          }
        }
      },
      "TaskListEnvelope": {
        "type": "object",
        "required": ["data", "code", "status", "message"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskListResponse"
          },
          "code": {
            "type": "string",
            "example": "TASKS_LISTED"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "message": {
            "type": "string",
            "example": "Tasks listed successfully."
          }
        }
      },
      "EmptyEnvelope": {
        "type": "object",
        "required": ["data", "code", "status", "message"],
        "properties": {
          "data": {
            "nullable": true
          },
          "code": {
            "type": "string",
            "example": "TASK_DELETED"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "message": {
            "type": "string",
            "example": "Task deleted successfully."
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["data", "code", "status", "message"],
        "properties": {
          "data": {
            "nullable": true
          },
          "code": {
            "type": "string",
            "example": "TASK_NOT_FOUND"
          },
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "message": {
            "type": "string",
            "example": "Task was not found."
          }
        }
      },
      "AuthUserResponse": {
        "type": "object",
        "required": ["externalId", "provider"],
        "properties": {
          "externalId": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "provider": {
            "type": "string",
            "example": "google"
          }
        }
      },
      "RegisterUserRequest": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          }
        }
      },
      "TaskStatus": {
        "type": "string",
        "enum": ["Pending", "In Progress", "Done"]
      },
      "TaskResponse": {
        "type": "object",
        "required": ["id", "title", "status", "createdBy", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "dueDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "createdBy": {
            "type": "string"
          },
          "assignedTo": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskListResponse": {
        "type": "object",
        "required": ["items", "page", "pageSize"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "dueDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "assignedTo": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "dueDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "assignedTo": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UpdateTaskStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        }
      }
    }
  }
}
